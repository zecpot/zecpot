{
  "name": "zecpot",
  "version": "0.1.0",
  "private": true,
  "description": "zecPOT: a daily private ZEC pot on Zcash. 5% of every pot sweeps floor zkSNARKs for a weekly bonus. ZECATHON entry.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --import tsx --test packages/core/test/*.test.ts apps/engine/test/*.test.ts apps/web/test/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build:web": "node apps/web/build.mjs",
    "dev": "npm run build:web && node --import tsx apps/engine/src/cli.ts serve",
    "simulate": "node --import tsx apps/engine/src/cli.ts simulate",
    "tick": "node --import tsx apps/engine/src/cli.ts tick",
    "verify": "node --import tsx apps/engine/src/cli.ts verify",
    "serve": "npm run build:web && node --import tsx apps/engine/src/cli.ts serve",
    "blockhash": "node --import tsx apps/engine/src/cli.ts blockhash",
    "op": "node --import tsx apps/engine/src/cli.ts op"
  },
  "dependencies": {
    "@grpc/grpc-js": "1.13.4",
    "@grpc/proto-loader": "0.7.15",
    "@noble/curves": "1.9.7",
    "@noble/hashes": "1.8.0",
    "@scure/base": "1.2.6",
    "qrcode-generator": "1.4.4"
  },
  "devDependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.2.10",
    "@solana/spl-token": "0.4.13",
    "@solana/web3.js": "1.98.4",
    "@types/node": "22.18.0",
    "esbuild": "0.25.10",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
